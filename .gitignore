# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Secrets and local state — never commit these
.env
fyers_access_token.json

# NOTE: telegram_offset.json is intentionally NOT ignored: it is the shared
# Telegram getUpdates offset (see telegram_commands.py) and must persist
# between workflow runs, exactly like bot_control.json. Without it, every
# fresh checkout would re-answer old commands.

